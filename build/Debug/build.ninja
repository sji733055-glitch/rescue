#############################################
# Utility command for edit_cache

build cmsisdsp/Source/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D D:\robomaster\rm_embedded\rescue\build\Debug\cmsisdsp\Source && C:\msys64\mingw64\bin\cmake.exe -E echo "No interactive CMake dialog available.""
  DESC = No interactive CMake dialog available...
  restat = 1

build cmsisdsp/Source/edit_cache: phony cmsisdsp/Source/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build cmsisdsp/Source/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D D:\robomaster\rm_embedded\rescue\build\Debug\cmsisdsp\Source && C:\msys64\mingw64\bin\cmake.exe --regenerate-during-build -SD:\robomaster\rm_embedded\rescue\board -BD:\robomaster\rm_embedded\rescue\build\Debug"
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build cmsisdsp/Source/rebuild_cache: phony cmsisdsp/Source/CMakeFiles/rebuild_cache.util

